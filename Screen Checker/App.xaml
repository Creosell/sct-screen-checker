<Application
    x:Class="ScreenChecker.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ScreenChecker"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:v="clr-namespace:ScreenChecker.Views"
    xmlns:vmm="clr-namespace:ScreenChecker.ViewModels.MeasurementPage"
    xmlns:vms="clr-namespace:ScreenChecker.ViewModels.SettingsPage"
    Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/StringResources.xaml" />
                <ResourceDictionary Source="/Resources/Themes/Theme.Dark.xaml" />
                <materialDesign:BundledTheme
                    BaseTheme="Dark"
                    PrimaryColor="DeepPurple"
                    SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="/Resources/Styles/FieldStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vmm:MeasurementViewModel}">
                <v:MeasurementView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vms:SettingsViewModel}">
                <v:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>